# Copia este archivo a .env y cambia los valores. NUNCA subas .env al repo.
PORT=8086
LOG_LEVEL=info

MONGO_URL=mongodb://ai_svc:change-me-ai@localhost:27017/ai_db?authSource=ai_db
# Redis db 1: límite de chat por usuario (RNF8). Sin Redis se usa un contador en memoria.
REDIS_URL=redis://:change-me-redis@localhost:6379/1
AMQP_URL=amqp://festa:change-me-rabbit@localhost:5672
JWT_ISSUER=festa-auth
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
# FESTA_CONTRACTS_DIR=../festa-infra/contracts

# openai | gemini | anthropic | ollama. Sin LLM_API_KEY se usa "fake" (respuestas locales, sin costo).
# RNF8: usa modelos de bajo costo, p. ej. gemini-2.5-flash, gpt-4o-mini o claude-haiku-5-5.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_CHAT_MODEL=gemini-2.5-flash
LLM_DESCRIPTION_MODEL=gemini-2.5-flash
# OLLAMA_URL=http://localhost:11434
AI_CHAT_RATE_LIMIT_PER_MIN=10
AI_CHAT_MAX_CANDIDATES=25
